---
import HomeApp from "../components/home-app";
import { createWorkersLogger } from "evlog/workers";
import { hasAdminSession } from "../lib/admin-session";
import { ensureEvlogError } from "../lib/evlog";
import "../styles/global.css";

export const prerender = false;

const db = Astro.locals.runtime.env.DB;
const log = createWorkersLogger(Astro.request);
const initialIsAdmin = await hasAdminSession(
  Astro.request,
  Astro.locals.runtime.env.ADMIN_SECRET
);
let initialTweets: Array<{ id: number; embed_html: string; search_text?: string | null; sort_order: number; created_at: string }> | undefined;
try {
  const result = await db
    .prepare("SELECT id, embed_html, search_text, sort_order, strftime('%Y-%m-%dT%H:%M:%fZ', created_at) AS created_at FROM tweets ORDER BY sort_order ASC, id ASC")
    .all();
  initialTweets = (result.results ?? []) as NonNullable<typeof initialTweets>;
  log.set({ page: { route: "/", tweetCount: initialTweets.length } });
  log.emit({ status: 200 });
} catch (error) {
  const evlogError = ensureEvlogError(error, "Failed to load tweets for SSR");
  log.error(evlogError);
  log.emit({ status: 200 });
  // Leave undefined to trigger client-side fallback
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Twitmarks - Curate the noise. Save the signal.</title>
    <meta
      name="description"
      content="Your personal gallery of high-signal Twitter embeds. Organized, searchable, and beautifully presented."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet" />
    <script
      is:inline
    >
      try {
        const theme = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (theme === "dark" || (!theme && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      } catch {}
    </script>

  </head>
  <body>
    <HomeApp client:load initialIsAdmin={initialIsAdmin} initialTweets={initialTweets} />
  </body>
</html>
