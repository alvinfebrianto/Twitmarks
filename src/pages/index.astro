---
import HomeApp from "../components/home-app";
import "../styles/global.css";

export const prerender = false;

const db = Astro.locals.runtime.env.DB;
let initialTweets: Array<{ id: number; embed_html: string; sort_order: number; created_at: string }> | undefined;
try {
  const result = await db
    .prepare("SELECT * FROM tweets ORDER BY sort_order ASC, id ASC")
    .all();
  initialTweets = (result.results ?? []) as NonNullable<typeof initialTweets>;
} catch {
  // Leave undefined to trigger client-side fallback
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Twitmarks - Curate the noise. Save the signal.</title>
    <meta
      name="description"
      content="Your personal gallery of high-signal Twitter embeds. Organized, searchable, and beautifully presented."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Manrope:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script
      is:inline
    >
      try {
        const theme = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (theme === "dark" || (!theme && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      } catch {}
    </script>
    <script
      is:inline
      async
      src="https://platform.twitter.com/widgets.js"
      charset="utf-8"
    ></script>
  </head>
  <body>
    <HomeApp client:load initialTweets={initialTweets} />
  </body>
</html>
