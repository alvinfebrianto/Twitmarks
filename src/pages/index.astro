---
import HomeApp from "../components/home-app";
import { createWorkersLogger } from "evlog/workers";
import { hasAdminSession } from "../lib/admin-session";
import { getDbOrThrow } from "../lib/db";
import { ensureEvlogError } from "../lib/evlog";
import {
  createTweetMediaProxySigner,
  rewriteTweetMediaUrls,
} from "../lib/syndication";
import type { DbTweet } from "../lib/tweet-helpers";
import { parseStoredTweetData } from "../lib/tweet-snapshot";
import { ensureTweetsSearchTextColumn } from "../lib/tweets-schema";
import "../styles/global.css";

export const prerender = false;

const log = createWorkersLogger(Astro.request);
let initialIsAdmin = false;
let initialTweets: DbTweet[] | undefined;
try {
  const db = getDbOrThrow(Astro.locals);
  await ensureTweetsSearchTextColumn(db);
  initialIsAdmin = await hasAdminSession(Astro.request, db);
  const signTweetMediaUrl = await createTweetMediaProxySigner(
    db,
    Astro.locals.runtime.env.ADMIN_SECRET
  );

  const result = await db
    .prepare("SELECT id, embed_html, search_text, tweet_json, sort_order, strftime('%Y-%m-%dT%H:%M:%fZ', created_at) AS created_at FROM tweets ORDER BY sort_order ASC, id ASC")
    .all<Record<string, unknown>>();
  const rows: Record<string, unknown>[] = result.results ?? [];
  const tweets = await Promise.all(
    rows.map(async (row: Record<string, unknown>) => {
      const { tweet_json: tweetJson, ...tweet } = row;

      return {
        ...tweet,
        tweet_data: await rewriteTweetMediaUrls(
          parseStoredTweetData(tweetJson),
          signTweetMediaUrl
        ),
      } as DbTweet;
    })
  );
  initialTweets = tweets;
  log.set({ page: { route: "/", tweetCount: tweets.length } });
  log.emit({ status: 200 });
} catch (error) {
  const evlogError = ensureEvlogError(error, "Failed to load tweets for SSR");
  log.error(evlogError);
  log.emit({ status: 200 });
  // Leave undefined to trigger client-side fallback
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Twitmarks - Curate the noise. Save the signal.</title>
    <meta
      name="description"
      content="Your personal gallery of high-signal Twitter embeds. Organized, searchable, and beautifully presented."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline src="/theme-init.js"></script>

  </head>
  <body>
    <HomeApp client:load initialIsAdmin={initialIsAdmin} initialTweets={initialTweets} />
  </body>
</html>
