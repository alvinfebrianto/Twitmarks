{
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/react": "^5.0.1",
    "@biomejs/biome": "^2.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.4",
    "agentation": "^2.2.1",
    "astro": "^5.18.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "ultracite": "^7.2.4",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "dev": "astro dev",
    "deploy": "wrangler pages deploy dist",
    "db:create": "wrangler d1 create twitmarks-db",
    "db:schema:local": "wrangler d1 execute twitmarks-db --local --persist-to ./.cache/wrangler --file=schema.sql",
    "db:schema:remote": "wrangler d1 execute twitmarks-db --remote --file=schema.sql",
    "db:schema:all": "npm run db:schema:local && npm run db:schema:remote",
    "db:init": "npm run db:schema:local",
    "db:execute": "npm run db:schema:remote",
    "lint:fix": "ultracite fix",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "evlog": "^2.1.0",
    "motion": "^12.34.3",
    "react": "^19.2.4",
    "react-tweet": "^3.3.0"
  }
}
